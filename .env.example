NEXT_PUBLIC_DATA_MODE=api
NEXT_PUBLIC_API_URL=http://localhost:5080
# Produção (Vercel): NEXT_PUBLIC_API_URL=https://esotera-api.onrender.com
# testing = permite checkout de homologação sem Public Key do MP
# production = exige pagamento real configurado para checkout público
NEXT_PUBLIC_STORE_MODE=testing
# Só ative após configurar Access Token + webhook no Render
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
# Opcional — espelho do ambiente do backend (Test | Production)
NEXT_PUBLIC_MERCADO_PAGO_ENVIRONMENT=Test

# Backend / Render (não usar NEXT_PUBLIC_ no Access Token)
# Preferência tipada (também aceita MERCADO_PAGO_* flat):
MercadoPago__Environment=Test
MercadoPago__AccessToken=
MercadoPago__WebhookSecret=
MercadoPago__SandboxPixEnabled=true
MercadoPago__SandboxPixAmount=50.00
# Aliases flat equivalentes:
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ENVIRONMENT=Test
MERCADO_PAGO_SANDBOX_PIX_ENABLED=true
MERCADO_PAGO_SANDBOX_PIX_AMOUNT=50.00
PUBLIC_API_BASE_URL=https://esotera-api.onrender.com
# MERCADO_PAGO_NOTIFICATION_URL=https://esotera-api.onrender.com/api/webhooks/mercadopago

# Bootstrap do primeiro Admin — configurar no Render (nunca no frontend / NUNCA versionar valores reais)
# BOOTSTRAP_ADMIN_ENABLED=true
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# Após criar: BOOTSTRAP_ADMIN_ENABLED=false e remover BOOTSTRAP_ADMIN_PASSWORD

# E-mail (SMTP) — backend
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USE_SSL=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
# Timeout do SmtpClient (segundos). Padrão 15 — evita hang no Render.
# EMAIL_SMTP_TIMEOUT_SECONDS=15
EMAIL_FROM_ADDRESS=esoteralivraria1@gmail.com
EMAIL_FROM_NAME=Esotera
FRONTEND_BASE_URL=http://localhost:3000
# Opcional: aviso ao admin em novas inscrições da newsletter (só com SMTP ativo)
# EMAIL_ADMIN_NOTIFY=

# Site público (SEO / canonical / OG) — frontend
# NEXT_PUBLIC_SITE_URL=https://esotera.vercel.app

# Frete — Melhor Envio OAuth Sandbox (cotação via API /api/shipping/quote)
# Auth somente OAuth (authorize + tokens cifrados no banco). Sem access token estático.
MELHOR_ENVIO_ENABLED=false
MELHOR_ENVIO_ENVIRONMENT=sandbox
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
# Callback na API (deve coincidir com o cadastrado no app Melhor Envio)
# MELHOR_ENVIO_REDIRECT_URI=https://esotera-api.onrender.com/api/integrations/melhor-envio/callback
MELHOR_ENVIO_REDIRECT_URI=
# Ex.: Esotera (esoteralivraria1@gmail.com)
MELHOR_ENVIO_USER_AGENT=
# AES-256: 32 bytes em Base64 (gerar: openssl rand -base64 32). Rotação exige reautorizar.
INTEGRATIONS_ENCRYPTION_KEY=
# Schema no startup. false/ausente = deploy NÃO altera o banco.
# true = aplica migrations pendentes (MigrateAsync). Falha de migration derruba o processo.
DB_AUTO_MIGRATE=false
# Cotação ME no checkout: ativar pela flag admin "Cotação Melhor Envio ativa" (StoreSettings),
# independente de MELHOR_ENVIO_ENABLED e do status OAuth.

# J3 Flex — coverage real no quote/CreateOrder quando Enabled=true + config válida.
# Default disabled. Enabled=true exige URL, token, company group e J3_STANDARD_PRICE_CENTS > 0.
# Seller IDs / token: só em env (nunca hardcode no código). Não versionar valores reais.
# J3_ENABLED: quote/CreateOrder de NOVOS pedidos.
J3_ENABLED=false
# J3_FULFILLMENT_ENABLED: processador futuro pode executar mutations (claim/createTmsOrder).
# Default false. Mutations futuras exigem J3_ENABLED=true AND J3_FULFILLMENT_ENABLED=true.
# Pedido pago com método j3 registra J3Fulfillment Pending mesmo com fulfillment desligado.
# Config incompleta OK no startup enquanto as flags estão false.
J3_FULFILLMENT_ENABLED=false
# Recovery admin isolado: importOrderByAccessKey. Default false.
# No primeiro teste controlado: true com J3_FULFILLMENT_ENABLED=false (nunca ambos true).
J3_IMPORT_BY_ACCESS_KEY_ENABLED=false
J3_GRAPHQL_URL=
J3_TOKEN=
# Login Seller (portal) — preferido para mutations. Nunca versionar valores reais.
# J3_LOGIN_EMAIL=
# J3_LOGIN_PASSWORD=
# J3_LOGIN_URL=https://app.j3tms.com.br/api/auth/login
# J3_AUTH_RENEW_SKEW_MINUTES=5
J3_COMPANY_GROUP_CODE=J3
J3_SELLER_ID=
J3_SELLER_INFORMATION_ID=
J3_ORIGIN_ZIP=
# Telefone corporativo do emitente fiscal (fallback emitEnder.fone em importOrderByAccessKey).
# Ordem: XML enderEmit/fone → J3_EMITTER_PHONE → fail-closed. Somente dígitos no payload.
# J3_EMITTER_PHONE=
# Preço padrão em centavos (fonte única do preço J3). Valor comercial configurado externamente — sem secret.
# Vazio/0 com Enabled=true = config inválida (J3 não aparece). Sem default comercial no código.
J3_STANDARD_PRICE_CENTS=
# J3_TIMEOUT_SECONDS=15
# Diagnóstico admin: Processing com UpdatedAtUtc mais antigo que N minutos → IsPossiblyStuck.
# Não reprocessa e não chama J3. Default 15.
# J3_PROCESSING_STALE_MINUTES=15
# Preparação futura (não usados enquanto FulfillmentEnabled=false): Ecommerce / OrderPickupType.
# J3_ECOMMERCE=Standalone
# J3_ORDER_PICKUP_TYPE=Standard
# Schema createTmsOrder exige Boolean isFragile/isValuable. Default explícito Esotera: false
# até haver regra comercial (não é regra oficial J3).
# J3_PACKAGE_IS_FRAGILE=false
# J3_PACKAGE_IS_VALUABLE=false

# UpSeller — exportação de pedidos (layout oficial). Sem secrets.
# UPSELLER_STORE_NAME=Loja Padrão
# UPSELLER_WAREHOUSE_NAME=My Warehouse
# UPSELLER_SHIPPING_COST_METHOD=2
# UPSELLER_PACKAGE_QUANTITY=1
# UPSELLER_INVOICE_REQUIRED=Não
# UPSELLER_DEFAULT_PAYMENT_METHOD=Dinheiro

# Cloudinary — configurar no backend (backend/.env ou variáveis de ambiente do processo da API).
# NÃO use NEXT_PUBLIC_ para CLOUDINARY_API_SECRET.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_PRODUCTS_FOLDER=esotera/products
