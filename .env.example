NEXT_PUBLIC_DATA_MODE=api
NEXT_PUBLIC_API_URL=http://localhost:5080
# Produção (Vercel): NEXT_PUBLIC_API_URL=https://esotera-api.onrender.com
# testing = permite checkout de homologação sem Public Key do MP
# production = exige pagamento real configurado para checkout público
NEXT_PUBLIC_STORE_MODE=testing
# Só ative após configurar Access Token + webhook no Render
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
# Opcional — espelho do ambiente do backend (Test | Production)
NEXT_PUBLIC_MERCADO_PAGO_ENVIRONMENT=Test

# Backend / Render (não usar NEXT_PUBLIC_ no Access Token)
# Preferência tipada (também aceita MERCADO_PAGO_* flat):
MercadoPago__Environment=Test
MercadoPago__AccessToken=
MercadoPago__WebhookSecret=
MercadoPago__SandboxPixEnabled=true
MercadoPago__SandboxPixAmount=50.00
# Aliases flat equivalentes:
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ENVIRONMENT=Test
MERCADO_PAGO_SANDBOX_PIX_ENABLED=true
MERCADO_PAGO_SANDBOX_PIX_AMOUNT=50.00
PUBLIC_API_BASE_URL=https://esotera-api.onrender.com
# MERCADO_PAGO_NOTIFICATION_URL=https://esotera-api.onrender.com/api/webhooks/mercadopago

# Bootstrap do primeiro Admin — configurar no Render (nunca no frontend / NUNCA versionar valores reais)
# BOOTSTRAP_ADMIN_ENABLED=true
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# Após criar: BOOTSTRAP_ADMIN_ENABLED=false e remover BOOTSTRAP_ADMIN_PASSWORD

# E-mail (SMTP) — backend
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USE_SSL=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=esoteralivraria1@gmail.com
EMAIL_FROM_NAME=Esotera
FRONTEND_BASE_URL=http://localhost:3000
# Opcional: aviso ao admin em novas inscrições da newsletter (só com SMTP ativo)
# EMAIL_ADMIN_NOTIFY=

# Site público (SEO / canonical / OG) — frontend
# NEXT_PUBLIC_SITE_URL=https://esotera.vercel.app

# Frete — preparação (NÃO integrados; cotação atual é simulada)
MELHOR_ENVIO_ENABLED=false
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
# MELHOR_ENVIO_ENVIRONMENT=sandbox
J3_ENABLED=false
J3_API_URL=
J3_API_TOKEN=

# Cloudinary — configurar no backend (backend/.env ou variáveis de ambiente do processo da API).
# NÃO use NEXT_PUBLIC_ para CLOUDINARY_API_SECRET.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_PRODUCTS_FOLDER=esotera/products
