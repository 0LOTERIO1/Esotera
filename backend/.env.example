# Cloudinary — desenvolvimento local via User Secrets (não versionar valores reais).
# Produção/deploy: variáveis de ambiente do processo com os mesmos nomes.
# NUNCA use NEXT_PUBLIC_ para o secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCTS_FOLDER=esotera/products

# Bootstrap do primeiro Admin (produção). Deixe ENABLED=false após criar.
# Nunca versionar e-mail/senha reais. Não habilitar em Development com DevSeed se não precisar.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
